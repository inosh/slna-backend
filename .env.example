# ============================================================
# SLNA Backend - Environment Variables
# ============================================================
# Copy this file to ".env" (remove ".example" from the name)
# and fill in your actual local values.
#
# NEVER commit the real .env file to GitHub -- it contains
# secrets. This .env.example file (with placeholder values)
# is safe to share/commit.
# ============================================================

# --- Local PostgreSQL connection ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_NAME=slna_db

# --- Server ---
PORT=3000

# --- CORS ---
# Comma-separated list of frontend origin(s) allowed to call this API from
# a browser (no trailing slash). Falls back to SITE_URL below if left blank.
# Local dev (http://localhost:* and http://127.0.0.1:*) is always allowed.
CORS_ORIGIN=https://slna.lk

# --- JWT (used to sign login tokens) ---
# Generate a random string for this. Any long random text works.
# You can generate one by running this in Node:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

# --- Cloudflare R2 (file storage) ---
# Endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# Access key ID / secret: from an R2 API token (Account Home > R2 > Manage API Tokens)
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# Bucket names
R2_BUCKET_PUBLIC=slna-dev-public
R2_BUCKET_PRIVATE=slna-dev-private
# Public base URL for the public bucket (custom domain or r2.dev URL, no trailing slash)
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev

# --- Email (Resend) ---
# API key from resend.com/api-keys. Leave blank to disable email sending
# (it will just log a warning).
#
# Master switch: set to "false" to turn off all outgoing email regardless
# of the credentials below. Defaults to enabled (any value other than the
# literal string "false" is treated as on).
EMAIL_ENABLED=true
RESEND_API_KEY=your_resend_api_key
MAIL_FROM="SLNA Website <noreply@slna.lk>"

# --- Email notifications: secretary recipient + frontend link ---
# Secretary gets notified of new membership applications / event
# registrations / contact queries. Leave blank to skip that notification
# entirely.
SECRETARY_EMAIL=secretary@slna.lk
# Base URL of the deployed frontend (no trailing slash), used to build the
# staff admin login link in secretary notification emails, e.g.
# https://slna.lk or http://127.0.0.1:5500 for local testing. Leave blank
# and the emails will use a relative link (/pages/admin-login.html) instead.
SITE_URL=https://slna.lk

# --- Nightly DB backup (db/backup-to-r2.js) ---
# Separate, narrowly-scoped R2 token (Object Read & Write on the backups
# bucket only) -- NOT the app's normal R2_ACCESS_KEY_ID/R2_SECRET_ACCESS_KEY.
# Create via Cloudflare dashboard > R2 > Manage API Tokens, scoped to only
# the backups bucket (create that bucket first if it doesn't exist).
BACKUP_R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
BACKUP_R2_ACCESS_KEY_ID=your_backup_r2_access_key_id
BACKUP_R2_SECRET_ACCESS_KEY=your_backup_r2_secret_access_key
BACKUP_R2_BUCKET=slna-prod-backups
BACKUP_RETENTION_DAYS=30
# Where backup-FAILURE alerts go -- a technical inbox, not the office/secretary one.
BACKUP_ALERT_EMAIL=tech@slna.lk
